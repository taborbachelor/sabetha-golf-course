# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only key must never be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, only used locally to apply migrations
# (Dashboard > Connect > Session pooler URI, with your database password)
SUPABASE_DB_URL=

# Square: SANDBOX ONLY until Phase 4
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Search engines are blocked unless this is "true". Leave unset until go-live.
ALLOW_INDEXING=
