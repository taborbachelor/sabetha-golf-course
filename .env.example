# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where membership applications are emailed (Club Secretary)
SECRETARY_EMAIL=

# Supabase (server-only key must never be exposed to the browser)
